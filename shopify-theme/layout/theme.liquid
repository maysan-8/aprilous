<!doctype html>
{%- liquid
  assign rtl_langs = 'he,ar,fa,ur'
  assign lang = request.locale.iso_code | split: '-' | first
  if rtl_langs contains lang
    assign dir = 'rtl'
  else
    assign dir = 'ltr'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fffaf6">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_page != 1 %} · {{ current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_image -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,400;1,500&display=swap" rel="stylesheet">
  {{ 'aprilous.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --rose-700: {{ settings.color_accent }};
      --plum-900: {{ settings.color_ink }};
      --uv-500: {{ settings.color_uv }};
      --bg: {{ settings.color_background }};
    }
  </style>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}
  <div class="toast" role="status" aria-live="polite"></div>

  <script>
    window.Aprilous = {
      routes: {
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        root: {{ routes.root_url | json }}
      },
      moneyFormat: {{ shop.money_format | json }},
      freeShipping: {{ settings.free_shipping_threshold | times: 100 | json }},
      strings: {
        added: {{ 'cart.added' | t | json }},
        empty: {{ 'cart.empty_html' | t | json }},
        free: {{ 'cart.free_shipping_reached' | t | json }},
        toFree: {{ 'cart.to_free_shipping' | t | json }},
        remove: {{ 'cart.remove' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        addToCart: {{ 'products.add_to_cart' | t | json }},
        subscribed: {{ 'newsletter.success' | t | json }},
        error: {{ 'cart.error' | t | json }}
      }
    };
  </script>
  <script src="{{ 'aprilous.js' | asset_url }}" defer></script>
</body>
</html>
