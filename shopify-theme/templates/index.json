      "type": "faq",
      "blocks": {
        "q1": { "type": "question", "settings": { "question": "האם קרינת ה-UV בטוחה?", "answer": "<p>כן. נורות ה-UV-C פועלות בתוך המכשיר הסגור, אוטומטית בכל מחזור ייבוש או בנגיעה אחת, למשך 10 דקות.</p>" } },
        "q2": { "type": "question", "settings": { "question": "אילו מברשות מתאימות למכשיר?", "answer": "<p>כמעט כל מברשת — 6 מתאמים (2 גדולים, 2 בינוניים, 2 קטנים) לקטרים של 2–25 מ״מ, וגם תושבת מיוחדת לספוגים.</p>" } },
        "q3": { "type": "question", "settings": { "question": "כמה זמן לוקח הייבוש?", "answer": "<p>יש 4 מצבי טמפרטורה וטיימרים של 150, 180 או 210 דקות. הכי נוח: מנקות לפני השינה ומתעוררות למברשות יבשות.</p>" } },
        "q4": { "type": "question", "settings": { "question": "מה זה Late Pledge?", "answer": "<p>קמפיין ה-Kickstarter שלנו הסתיים בהצלחה ו-Luné בדרך לייצור. ה-Late Pledge הוא ההזדמנות האחרונה להצטרף לפני המכירה בחנויות — עם המחיר הכי טוב שיש.</p>" } }
