<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="{{ routes.root_url }}" class="logo"><span class="logo-dot"></span>{{ shop.name | downcase }}</a>
        {%- if section.settings.about != blank -%}<p class="about">{{ section.settings.about }}</p>{%- endif -%}
        <div class="socials">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 3 2.5 5 5.5 5"/></svg></a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z"/></svg></a>{%- endif -%}
        </div>
      </div>
      {%- for menu_key in (1..2) -%}
        {%- if menu_key == 1 -%}{%- assign menu = section.settings.menu_1 -%}{%- else -%}{%- assign menu = section.settings.menu_2 -%}{%- endif -%}
        {%- if menu != blank -%}
          <div>
            <h4>{{ menu.title }}</h4>
            <ul>
              {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div>
        <h4>{{ section.settings.newsletter_heading }}</h4>
        {%- if section.settings.newsletter_text != blank -%}<p class="about" style="margin:0 0 14px">{{ section.settings.newsletter_text }}</p>{%- endif -%}
        {%- form 'customer', class: 'newsletter', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button class="btn btn-primary" type="submit">{{ 'newsletter.submit' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="form-ok">{{ 'newsletter.success' | t }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights' | t }}</span>
      <span>
        {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{% unless forloop.last %} · {% endunless %}{%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "default": "Luné by Aprilous — ניקוי, ייבוש וחיטוי UV-C למברשות איפור. כי יופי אמיתי מתחיל בניקיון." },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "הצטרפי למועדון" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "10% הנחה על ההזמנה הראשונה + טיפים ליופי נקי." }
  ]
}
{% endschema %}
