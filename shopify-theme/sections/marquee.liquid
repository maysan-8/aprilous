<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "חיטוי UV-C" }] }
  ],
  "presets": [{
    "name": "Scrolling text",
    "blocks": [
      { "type": "item", "settings": { "text": "ניקוי בסחרור" } },
      { "type": "item", "settings": { "text": "ייבוש בחום עדין" } },
      { "type": "item", "settings": { "text": "חיטוי UV-C" } },
      { "type": "item", "settings": { "text": "5 מצבי תאורה" } },
      { "type": "item", "settings": { "text": "מ-2 עד 25 מ״מ" } },
      { "type": "item", "settings": { "text": "שקט 40dB" } }
    ]
  }]
}
{% endschema %}
