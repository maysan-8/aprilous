{%- if section.settings.text != blank -%}
  <div class="announce">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "✦ ה-Late Pledge פתוח עכשיו · <strong>עד 50% הנחה לפני המכירה בחנויות</strong> ✦" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
